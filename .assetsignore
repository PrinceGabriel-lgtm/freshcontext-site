# Everything here is excluded from the published static-asset bundle.
#
# Stated explicitly rather than relying on Cloudflare skipping dot-entries by
# default. That default is not something this repository should depend on: if it
# does not hold, `.git/` alone would publish the entire repository history as
# static assets. An inherited conditional default is exactly the shape of bug that
# turned the workers.dev hostname off in freshcontext-mcp, so this file names what
# ships instead of assuming.

# Version control and CI
.git/
.github/
.gitignore
.assetsignore

# Dependencies. These are gitignored, so they are absent from a clean clone —
# but the build installs them before `wrangler deploy` uploads `directory: "."`,
# and at that point they are ordinary files in the asset root.
node_modules/

# Local state and secrets. All gitignored and so normally absent; named here
# because the cost of one of them being present once is publishing a secret,
# and the cost of naming them is four lines.
.wrangler/
.dev.vars
.env
.env.*

# Tooling config and test material
README.md
package.json
package-lock.json
playwright.config.js
.htmlvalidate.json
tests/
test-results/
playwright-report/

# Install scripts are distributed through the docs, not served from the site
install.ps1
install.sh

# Deployment config
wrangler.jsonc
