# Response headers for the static site.
#
# The policy below is deliberately narrow because the site is narrow: no images,
# no third-party fonts, no analytics. Every directive names what is actually used,
# so a future change that needs something new has to say so here rather than
# inherit it. Outbound requests: the npm registry (version badge), the application
# intake (intake.freshcontext.dev, fetch only), and Cloudflare Turnstile
# (challenges.cloudflare.com: its script and its challenge frame) on /apply.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; script-src 'self' https://challenges.cloudflare.com; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://registry.npmjs.org https://intake.freshcontext.dev; frame-src https://challenges.cloudflare.com; form-action 'none'; frame-ancestors 'none'; upgrade-insecure-requests

# The schema is published to be fetched by other people's tooling — validators,
# editors, CI — so it is the one path that answers cross-origin. Nothing else on
# the site does, which is why this is a path rule and not a site-wide header.
/freshcontext.schema.json
  Access-Control-Allow-Origin: *
  Cross-Origin-Resource-Policy: cross-origin
  Cache-Control: public, max-age=3600

# The card is fetched by crawlers and chat clients that are, by definition,
# another origin.
/og.png
  Cross-Origin-Resource-Policy: cross-origin
  Cache-Control: public, max-age=86400

# The build stamp answers "which commit is live right now". A cached copy would
# answer "which commit was live when you last asked", which is the one question
# it is not for. The deploy smoke test also cache-busts, but a human reading it
# in a browser gets the truth without knowing to.
/build.json
  Cache-Control: no-store
  X-Robots-Tag: noindex
